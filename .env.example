NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Explicit application stage. Use local, preview, or production.
APP_ENVIRONMENT=local
# Canonical app origin used in password-recovery links (no trailing slash).
APP_URL=https://waterfront-reservations.vercel.app
# Server-only. Required by administrative API routes and setup scripts; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Preferred current secret-key name. Configure one server-only admin key, never both in the browser.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Comma-separated, server-only allowlist. Matching authenticated users are safely
# bootstrapped as Superadmins when no active profile exists for their account.
SUPERADMIN_EMAILS=you@waterfrontiloilo.com

# Local and automated visual testing only. This is ignored when NODE_ENV=production.
APP_DEMO_MODE=false

# Phase 2 is disabled in production until Waterfront management approves the launch checklist.
NEXT_PUBLIC_PHASE2_PREVIEW=false
PHASE2_PUBLIC_BOOKING_ENABLED=false

# Provider-neutral transactional email. Use "local" for development; leave "disabled" in production until approved.
TRANSACTIONAL_EMAIL_PROVIDER=local
BOOKING_EMAIL_FROM=reservations@YOUR_VERIFIED_DOMAIN
RESEND_API_KEY=

# Optional abuse-mitigation boundary. No CAPTCHA is required for local preview.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Phase 3 WhatsApp Cloud API. Leave blank/disabled until Meta assets, templates,
# consent language, credential ownership, and the pilot are approved. Never hardcode a Graph version.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Phase 4 CRM and marketing. Every production-facing flag defaults off.
CRM_PROFILES_ENABLED=false
CRM_MERGE_ENABLED=false
MARKETING_SEGMENTS_ENABLED=false
MARKETING_EMAIL_SEND_ENABLED=false
MARKETING_WHATSAPP_SEND_ENABLED=false
MARKETING_EXPORTS_ENABLED=false
MARKETING_EMERGENCY_STOP=true

# Provider-neutral marketing email boundary. Configure only after Waterfront approves the
# consent text, frequency/quiet-hours policy, sender domain, SPF/DKIM/DMARC, and provider contract.
MARKETING_EMAIL_PROVIDER=disabled
MARKETING_EMAIL_FROM=
MARKETING_EMAIL_REPLY_TO=
MARKETING_EMAIL_API_KEY=
MARKETING_EMAIL_WEBHOOK_SECRET=
